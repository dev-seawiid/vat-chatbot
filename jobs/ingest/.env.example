# services/ingest-py가 필요로 하는 env. PDF fetch/extract/chunk/embed/load 스크립트가
# 모두 사용. Gemini는 응답 plane(apps/web/packages/core)에서만 소비되므로 본 plane엔
# 들어가지 않는다.

# Voyage AI — 청크 임베딩 (input_type=document)
# https://www.voyageai.com/
VOYAGE_API_KEY=

# Postgres + pgvector — documents/chunks upsert
# 로컬은 docker-compose 기본값, Neon 사용 시 connection string으로 교체.
DATABASE_URL=postgresql://vat_user:vat_pw@localhost:5432/vat_db
