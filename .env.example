# Voyage AI — embedding API (input_type=document)
# https://www.voyageai.com/ → dashboard에서 발급
VOYAGE_API_KEY=

# Postgres + pgvector — 로컬은 docker-compose 기본값(미설정 시 아래 URL로 자동 사용).
# Neon 사용 시 dashboard의 connection string으로 교체 (sslmode=require 포함).
DATABASE_URL=postgresql://vat_user:vat_pw@localhost:5432/vat_db
