# apps/web (Next.js)가 필요로 하는 env. /api/chat이 @vat/core의 retrieve+generate+savePair를
# 호출하면서 모듈 init 시점에 모두 소비된다.
#
# Next.js는 자기 디렉토리(apps/web)의 .env*만 자동 로드한다 — 모노레포 부모의 .env는
# 보지 않으므로 본 파일이 apps/web 환경 컨트랙트의 단일 진실.
#
# 클라이언트 번들에 노출돼야 하는 값은 NEXT_PUBLIC_ prefix 필요 — 현재 슬라이스에선
# 모두 서버 전용(route handler).

# Voyage AI — 질문 임베딩 (서버 전용)
# https://www.voyageai.com/
VOYAGE_API_KEY=

# Google AI Studio — Gemini 응답 생성 (서버 전용, 무료 티어)
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Postgres + pgvector — chunks 검색 + conversations/messages 영속화 (서버 전용)
DATABASE_URL=postgresql://vat_user:vat_pw@localhost:5432/vat_db

# Langfuse — LLM observability (OTEL 기반). instrumentation.node.ts의 LangfuseSpanProcessor가
# 직접 process.env로 소비하므로 zod 스키마(parseEnv)는 통과하지 않는다.
# 미설정 시 trace는 drop(앱 동작엔 영향 없음). 로컬 docker-compose self-host 또는 Cloud 둘 다
# 같은 키 이름, BASE_URL만 차이.
# https://cloud.langfuse.com (EU) / https://us.cloud.langfuse.com (US) / self-host URL
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
