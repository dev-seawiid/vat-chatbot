{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "#common/*": ["./src/common/*"],
      "#modules/*": ["./src/modules/*"],
      "#database/*": ["./src/database/*"]
    }
  },
  "include": ["src/**/*", "scripts/**/*", "drizzle.config.ts"]
}
