# packages/core CLI 진입점 (pnpm core:ask, core:query, db:generate, db:migrate)이
# 사용하는 env. CLI 스크립트가 `import "dotenv/config"`로 cwd(=packages/core)의 .env를
# 자동 로드하면, 이 파일이 process.env에 주입된다.
#
# 라이브러리 코드(@vat/core)는 process.env를 직접 읽지 않는다 — 본 .env는 오로지
# packages/core를 직접 실행할 때(scripts/, drizzle-kit)만 의미가 있다. 다른 plane이
# @vat/core를 import하는 경우엔 그쪽 plane이 자기 env를 createCore에 인자로 넘긴다.

# Voyage AI — retrieve 시 질문 임베딩
# https://www.voyageai.com/
VOYAGE_API_KEY=

# Google AI Studio — Gemini 응답 생성 (무료 티어)
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Postgres + pgvector — 로컬은 docker-compose 기본값
# Neon 사용 시 dashboard의 connection string으로 교체 (sslmode=require 포함).
DATABASE_URL=postgresql://vat_user:vat_pw@localhost:5432/vat_db
