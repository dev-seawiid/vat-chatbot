{
  "name": "vat-chatbot",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "compose:up": "docker compose up -d postgres",
    "compose:down": "docker compose down",
    "compose:logs": "docker compose logs -f postgres",
    "db:psql": "docker compose exec postgres psql -U vat_user -d vat_db",
    "db:generate": "pnpm -F @vat/core db:generate",
    "db:migrate": "pnpm -F @vat/core db:migrate",
    "db:studio": "pnpm -F @vat/core db:studio",
    "ingest:sync": "pnpm -F @vat/ingest run sync",
    "ingest:fetch": "pnpm -F @vat/ingest run fetch",
    "ingest:extract": "pnpm -F @vat/ingest run extract",
    "ingest:chunk": "pnpm -F @vat/ingest run chunk",
    "ingest:embed": "pnpm -F @vat/ingest run embed",
    "ingest:load": "pnpm -F @vat/ingest run load",
    "ingest:all": "pnpm -F @vat/ingest run all",
    "core:query": "pnpm -F @vat/core query",
    "core:ask": "pnpm -F @vat/core ask",
    "ragas-eval:sync": "pnpm -F @vat/ragas-eval run sync",
    "ragas-eval:eval": "pnpm -F @vat/ragas-eval run eval",
    "web:dev": "pnpm -F @vat/web dev",
    "web:build": "pnpm -F @vat/web build",
    "web:lint": "pnpm -F @vat/web lint"
  }
}
